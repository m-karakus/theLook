# ============================================================
# Credentials Configuration -- theLook ELT Pipeline
# ============================================================
#
# HOW TO USE:
#   1. Copy:  cp .credentials.yaml.example .credentials.yaml
#   2. Fill in real values (replace every CHANGEME)
#   3. Place your GCP service account JSON at ./gcp-credentials.json
#
# ARCHITECTURE:
#   BigQuery (source) -> mkpipe -> ClickHouse (DWH)
#   ClickHouse -> dbt -> ClickHouse (transformed tables)
#   Dagster orchestrates everything, backed by PostgreSQL
#
# SECURITY:
#   .credentials.yaml is in .gitignore -- NEVER commit it.
# ============================================================

dev:
  # -- mkpipe: settings + connections --
  mkpipe:
    settings:
      timezone: UTC
      log_dir: ./logs
      backend:
        variant: postgres
        host: postgres
        port: 5432
        database: mkpipe
        user: postgres
        password: postgres
        schema: public

    connections:
      bq_source:
        variant: bigquery
        database: bigquery-public-data
        schema: thelook_ecommerce
        credentials_file: /app/.ssh/gcp-credentials.json

      ch_target:
        variant: clickhouse
        host: clickhouse
        port: 8123
        database: thelook
        user: default
        password: clickhouse

  # -- dbt: profiles.yml --
  dbt:
    dbt_project:
      target: dev
      outputs:
        dev:
          type: clickhouse
          host: clickhouse
          port: 8123
          user: default
          password: clickhouse
          schema: thelook
          secure: false
          threads: 4

  # -- dagster: merged into dagster.yaml --
  dagster:
    storage:
      postgres:
        postgres_db:
          hostname: postgres
          username: postgres
          password: postgres
          db_name: dagster
          port: 5432
